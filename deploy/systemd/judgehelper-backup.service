[Unit]
Description=Judge Helper SQLite backup
After=local-fs.target

[Service]
Type=oneshot
User=judgehelper
Group=judgehelper
WorkingDirectory=/srv/judgehelper
ExecStart=/usr/bin/python3 -m scripts.backup_db
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/judgehelper
ReadWritePaths=/var/lib/judgehelper /var/backups/judgehelper
