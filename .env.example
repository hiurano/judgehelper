# API Keys
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Configuration
LLM_MODEL=openai/gpt-4o-mini
# Optional, comma-separated. Add only providers approved to receive court data.
LLM_FALLBACK_MODELS=

# Network & Webhooks
BASE_URL=https://judgehelper.ru
WEBHOOK_SECRET=your_webhook_secret_here
# Leave empty for the default same-origin web UI.
ALLOWED_ORIGINS=

# Authentication (required on a new database)
AUTH_USERNAME=admin
AUTH_PASSWORD=your_secure_password
SECRET_KEY=your_random_cookie_secret_key

# Database & Cleanup
JOB_TTL_DAYS=30
DB_PATH=backend/data/jobs.db
HOST_DATA_DIR=./backend/data
HOST_LOGS_DIR=./backend/logs
PROMPT_FILE=./prompts/system-protocol.md
BACKUP_DIR=./backend/data/backups
BACKUP_RETENTION_DAYS=30
# Owner recorded for a job stored without one; not a login and not a fallback
# for authorization.
DEFAULT_USER=test
MAX_UPLOAD_BYTES=1073741824
MAX_RENDER_TEXT_CHARS=500000
MAX_ACTIVE_JOBS_PER_USER=3
# Give up on a job still processing after this many hours, so a wedged one
# stops holding an active slot. Generous: a full hearing takes minutes.
JOB_MAX_LIFETIME_HOURS=6

# Docker host user/group owning backend/data and backend/logs
APP_UID=1000
APP_GID=1000

# Caddy Domain (used for Auto-HTTPS)
CADDY_DOMAIN=judgehelper.ru
